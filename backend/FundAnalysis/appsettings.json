{
  "Database": {
    // sqlite / mysql / postgresql / oracle / sqlserver
    // 切换数据库：改 Provider + 下方连接串，并重新生成迁移（见 README"多数据库支持"）：
    //   cd backend/FundAnalysis
    //   rm -rf ../FundAnalysis.Core/Migrations
    //   dotnet ef migrations add Init --project ../FundAnalysis.Core
    "Provider": "sqlite"
  },
  "ConnectionStrings": {
    // sqlite（默认，零配置）:
    "Default": "Data Source=fundanalysis.db"
    // mysql:      "Server=localhost;Port=3306;Database=fund_analysis;User=fund;Password=change_me;"
    // postgresql: "Host=localhost;Port=5432;Database=fund_analysis;Username=fund;Password=change_me"
    // sqlserver:  "Server=localhost;Database=FundAnalysis;User Id=sa;Password=change_me;TrustServerCertificate=True"
    // oracle:     "User Id=fund;Password=change_me;Data Source=//localhost:1521/XEPDB1"（要求 19c+）
  },
  "Jwt": {
    "Key": "FundAnalysis_Jwt_Secret_Key_Please_Change_Me_0123456789",
    "Issuer": "FundAnalysis",
    "Audience": "FundAnalysisClient",
    "ExpireMinutes": 120,
    "RefreshDays": 7
  },
  "Quote": {
    "Provider": "eastmoney"
  },
  "Cors": {
    "Origins": []
  },
  "Seed": {
    "AdminPassword": "Admin@123"
  },
  "Collector": {
    "SampleSymbols": [ "600519", "000001", "300750", "510300", "110022" ]
  },
  "Tushare": {
    "Token": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*"
}
