{
  "Database": {
    // sqlite / mysql / postgresql / oracle / sqlserver
    // 部署到服务器与 Web 端共享数据库时，改为你实际的数据库（JSON 配置支持 // 注释）
    "Provider": "sqlite"
  },
  "ConnectionStrings": {
    // 默认 sqlite 用于本机测试；服务器部署示例：
    //   mysql:      "Server=db;Port=3306;Database=fund_analysis;User=fund;Password=change_me;"
    //   postgresql: "Host=db;Port=5432;Database=fund_analysis;Username=fund;Password=change_me"
    "Default": "Data Source=fundanalysis.db"
  },
  "Collector": {
    // 与 Web 端一起采集的示例/兜底标的（所有用户自选会自动并入采集范围）
    "SampleSymbols": [ "600519", "000001", "300750", "510300", "110022" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
