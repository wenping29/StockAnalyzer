{
  "Database": {
    // sqlite / mysql / postgresql / oracle / sqlserver
    // 必须与 Web 端共用同一数据库：Collector 入库、API 读库指向同一份数据，切勿用 sqlite 分开
    "Provider": "postgresql"
  },
  "ConnectionStrings": {
    // 与 Web 端共用同一 PostgreSQL 实例/库（43.142.147.244:5454/fund_db）
    "Default": "Host=43.142.147.244;Port=5454;Database=fund_db;Username=fundmanager;Password=admin123456"
  },
  "Collector": {
    // 与 Web 端一起采集的示例/兜底标的（所有用户自选会自动并入采集范围）
    "SampleSymbols": [ "600519", "000001", "300750", "510300", "110022" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
